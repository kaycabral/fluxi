          "value": "extract(day from \"entries\".\"start_month\") = 1"
        },
        "entries_end_month_valid": {
          "name": "entries_end_month_valid",
          "value": "\"entries\".\"end_month\" is null or (extract(day from \"entries\".\"end_month\") = 1 and \"entries\".\"end_month\" >= \"entries\".\"start_month\" and \"entries\".\"recurrence\" in ('monthly', 'yearly'))"
        },
        "entries_installments_valid": {
          "name": "entries_installments_valid",
          "value": "(\"entries\".\"recurrence\" = 'installments') = (\"entries\".\"installments\" is not null) and (\"entries\".\"installments\" is null or \"entries\".\"installments\" >= 1)"
        },
        "entries_transfer_fields": {
          "name": "entries_transfer_fields",
          "value": "case when \"entries\".\"kind\" = 'transfer'\n        then \"entries\".\"to_account_id\" is not null and \"entries\".\"to_account_id\" <> \"entries\".\"account_id\" and \"entries\".\"category_id\" is null and \"entries\".\"pot\" is null\n        else \"entries\".\"to_account_id\" is null end"
        },
        "entries_pot_expense_only": {
          "name": "entries_pot_expense_only",
          "value": "\"entries\".\"pot\" is null or \"entries\".\"kind\" = 'expense'"
        }
      },
